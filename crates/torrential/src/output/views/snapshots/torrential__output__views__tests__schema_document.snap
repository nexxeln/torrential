        },
        {
          "name": "--max-size",
          "help": "The largest download get starts without its own --max-size, for example 8GB, or none",
          "takes_value": true,
          "repeatable": false,
          "value_name": "SIZE"
        },
        {
          "name": "--playback",
          "help": "What your player handles, when it is not this machine's. auto goes back to the display",
          "takes_value": true,
          "repeatable": false,
          "value_name": "PLAYBACK",
          "values": [
            "hevc-hdr",
            "hevc",
            "h264",
            "auto"
          ]
        },
        {
          "name": "--updates",
          "help": "Whether torrential says when a newer version is out, installs it in the background, or never looks",
