{
  "schema": 1,
  "type": "schema",
  "version": "0.1.0",
  "commands": [
    {
      "name": "search",
      "about": "Search the enabled sources",
      "arguments": [
        {
          "name": "WORDS",
          "help": "Words to search for",
          "required": true,
          "repeatable": true
        }
      ],
      "flags": [
        {
          "name": "--source",
          "help": "Search only this source. Repeat to add more",
          "takes_value": true,
          "repeatable": true,
          "value_name": "NAME"
        },
        {
          "name": "--category",
          "help": "Show only this kind of content",
          "takes_value": true,
          "repeatable": false,
          "value_name": "CATEGORY",
          "values": [
            "video",
            "audio",
            "software",
            "book",
            "game",
            "dataset",
            "other"
          ]
        },
        {
          "name": "--min-seeds",
          "help": "Hide results with fewer reported seeders, and results with unknown seeders",
          "takes_value": true,
          "repeatable": false,
          "value_name": "N"
        },
        {
          "name": "--max-size",
          "help": "Hide results larger than this, for example 8GiB, and results with unknown size",
          "takes_value": true,
          "repeatable": false,
          "value_name": "SIZE"
        },
        {
          "name": "--sort",
          "help": "Sort order. The default, relevance, ranks match quality above seed count",
          "takes_value": true,
          "repeatable": false,
          "value_name": "SORT",
          "values": [
            "relevance",
            "seeds",
            "size",
            "age"
          ],
          "default": "relevance"
        },
        {
          "name": "--limit",
          "help": "Number of results to show",
          "takes_value": true,
          "repeatable": false,
          "value_name": "N",
          "default": "10"
        },
        {
          "name": "--timeout",
          "help": "Stop waiting for slow sources after this long",
          "takes_value": true,
          "repeatable": false,
          "value_name": "DURATION",
          "default": "6s"
        },
        {
          "name": "--adult",
          "help": "Include adult results",
          "takes_value": false,
          "repeatable": false
        },
        {
          "name": "--fresh",
          "help": "Skip the result cache",
          "takes_value": false,
          "repeatable": false
        }
      ]
    },
    {
