{
  "schema": 1,
  "type": "schema",
  "version": "0.1.0",
  "commands": [
    {
      "name": "search",
      "about": "Search the enabled sources",
      "arguments": [
        {
          "name": "WORDS",
          "help": "Words to search for",
          "required": true,
          "repeatable": true
        }
      ],
      "flags": [
        {
          "name": "--source",
          "help": "Search only this source. Repeat to add more",
          "takes_value": true,
          "repeatable": true,
          "value_name": "NAME"
        },
        {
          "name": "--category",
          "help": "Show only this kind of content",
          "takes_value": true,
          "repeatable": false,
          "value_name": "CATEGORY",
          "values": [
            "video",
            "audio",
            "software",
            "book",
            "game",
            "dataset",
            "other"
          ]
        },
        {
          "name": "--min-seeds",
          "help": "Hide results with fewer reported seeders, and results with unknown seeders",
          "takes_value": true,
          "repeatable": false,
          "value_name": "N"
        },
        {
          "name": "--max-size",
          "help": "Hide results larger than this, for example 8GiB, and results with unknown size",
          "takes_value": true,
          "repeatable": false,
          "value_name": "SIZE"
        },
        {
          "name": "--sort",
          "help": "Order of the results. Relevance comes before popularity",
          "takes_value": true,
          "repeatable": false,
          "value_name": "SORT",
          "values": [
            "relevance",
            "seeds",
            "size",
            "age"
          ],
          "default": "relevance"
        },
        {
          "name": "--limit",
          "help": "Number of results to show",
          "takes_value": true,
          "repeatable": false,
          "value_name": "N",
          "default": "10"
        },
        {
          "name": "--timeout",
          "help": "Stop waiting for slow sources after this long",
          "takes_value": true,
          "repeatable": false,
          "value_name": "DURATION",
          "default": "6s"
        },
        {
          "name": "--adult",
          "help": "Include adult results",
          "takes_value": false,
          "repeatable": false
        },
        {
          "name": "--fresh",
          "help": "Skip the result cache",
          "takes_value": false,
          "repeatable": false
        }
      ]
    },
    {
      "name": "files",
      "about": "List the files in a torrent, fetching its metadata if needed",
      "arguments": [
        {
          "name": "REF",
          "help": "An ID prefix, infohash, magnet link, .torrent file, or .torrent URL",
          "required": true,
          "repeatable": false
        }
      ],
      "flags": [
        {
          "name": "--files",
          "help": "List only files matching this glob or exact path, as get --files would pick them. `*` crosses folders and case is ignored. Repeat to add more",
          "takes_value": true,
          "repeatable": true,
          "value_name": "GLOB"
        }
      ]
    },
    {
      "name": "get",
      "about": "Start a download, or change its file selection",
      "arguments": [
        {
          "name": "REF",
          "help": "An ID prefix, infohash, magnet link, .torrent file, or .torrent URL",
          "required": true,
          "repeatable": false
        }
      ],
      "flags": [
        {
          "name": "--files",
          "help": "Download only files matching this glob or exact path. `*` crosses folders and case is ignored. Repeat to add more",
          "takes_value": true,
          "repeatable": true,
          "value_name": "GLOB"
        },
        {
          "name": "--dir",
          "help": "The folder the download goes into",
          "takes_value": true,
          "repeatable": false,
          "value_name": "DIR"
        },
        {
          "name": "--max-size",
          "help": "The largest download allowed, for example 120GiB. Without it the cap is the max size from torrential setup, or 50 GiB",
          "takes_value": true,
          "repeatable": false,
          "value_name": "SIZE"
        },
        {
          "name": "--dry-run",
          "help": "Print the selected size, destination, free space, and conflicts without downloading",
          "takes_value": false,
          "repeatable": false
        }
      ]
    },
    {
      "name": "status",
      "about": "List downloads, or show one in detail",
      "arguments": [
        {
          "name": "ID",
          "help": "Download IDs from torrential status. None lists every download",
          "required": false,
          "repeatable": true
        }
      ],
      "flags": []
    },
    {
      "name": "wait",
      "about": "Follow downloads until they finish or the timeout passes",
      "arguments": [
        {
          "name": "ID",
          "help": "Download IDs from torrential status",
          "required": true,
          "repeatable": true
        }
      ],
      "flags": [
        {
          "name": "--until",
          "help": "Stop when the download is done, or as soon as its file list is known",
          "takes_value": true,
          "repeatable": false,
          "value_name": "UNTIL",
          "values": [
            "done",
            "metadata"
          ],
          "default": "done"
        },
        {
          "name": "--timeout",
          "help": "Give up after this long. Defaults to 100s, or no limit when a person watches in a terminal",
          "takes_value": true,
          "repeatable": false,
          "value_name": "DURATION"
        }
      ]
    },
    {
      "name": "pause",
      "about": "Pause downloads, returning once writes stop",
      "arguments": [
        {
          "name": "ID",
