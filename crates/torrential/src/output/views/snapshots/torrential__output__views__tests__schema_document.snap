          "name": "ID",
          "help": "A download ID from torrential status",
          "required": true,
          "repeatable": false
        }
      ],
      "flags": [
        {
          "name": "--repair",
          "help": "Download damaged pieces again",
          "takes_value": false,
          "repeatable": false
        }
      ]
    },
    {
      "name": "setup",
      "about": "Show what search ranks for on this machine, or set where you watch instead",
      "arguments": [],
      "flags": [
        {
          "name": "--screen",
          "help": "Where you watch, when it is not this machine's display. auto goes back to the display",
          "takes_value": true,
          "repeatable": false,
          "value_name": "SCREEN",
          "values": [
